# Copy this file to .env.macos-release and fill in your own Apple Developer values.
# Never commit .env.macos-release.

# Required for a signed Developer ID build outside the Mac App Store.
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Notarization with Apple ID + app-specific password.
APPLE_ID="you@example.com"
APPLE_PASSWORD="@keychain:PlateForge-notarization"
APPLE_TEAM_ID="TEAMID"

# Alternative notarization with App Store Connect API.
# APPLE_API_ISSUER="00000000-0000-0000-0000-000000000000"
# APPLE_API_KEY="ABC123DEFG"
# APPLE_API_KEY_PATH="/absolute/path/to/AuthKey_ABC123DEFG.p8"
